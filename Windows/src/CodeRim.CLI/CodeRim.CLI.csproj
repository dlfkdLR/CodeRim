<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>CodeRimCLI</AssemblyName>
    <PublishSingleFile Condition="'$(RuntimeIdentifier)' != ''">true</PublishSingleFile>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(RuntimeIdentifier)' != ''">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CodeRimInstalledCliHost)' == 'true'">
    <AssemblyName>CodeRimCLIHost</AssemblyName>
    <CodeRimCliPackageDependencies Condition="'$(CodeRimCliPackageDependencies)' == ''">Companion</CodeRimCliPackageDependencies>
    <DefineConstants>$(DefineConstants);CODERIM_INSTALLED_CLI_HOST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(CodeRimInstalledCliHost)' == 'true' and '$(CodeRimCliPackageDependencies)' == 'Companion'">
    <!-- Only GUI/worker installer manifest verification uses this assembly. The private
         companion handles local snapshots and hooks and exposes no update commands. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="$(CodeRimBouncyCastleVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RequireOwnedCliHost" BeforeTargets="PrepareForBuild" Condition="'$(CodeRimInstalledCliHost)' == 'true' and '$(CodeRimRustAccounting)' != 'true'">
    <Error Text="The installed CLI compatibility host requires the CodeRim-owned account boundary." />
  </Target>
  <ItemGroup><ProjectReference Include="../CodeRim.Core/CodeRim.Core.csproj" /></ItemGroup>
</Project>
