<Application x:Class="CodeRim.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:CodeRim.Windows.Views" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <!-- Use Windows Fluent templates for settings, including focus, disabled,
        selection and accessibility states. CodeRim's notch styles stay explicit. -->
   <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
   </Style>
   <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Padding" Value="12,5"/><Setter Property="MinHeight" Value="32"/>
   </Style>
   <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"/>
   <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}"/>
   <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
   <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}"/>
   <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   </Style>
   <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="MinHeight" Value="32"/><Setter Property="MaxDropDownHeight" Value="300"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
   </Style>
   <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="8,4"/><Setter Property="MinHeight" Value="32"/>
   </Style>
   <Style TargetType="PasswordBox" BasedOn="{StaticResource {x:Type PasswordBox}}"/>
   <Style x:Key="UsageLimitsDisclosure" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
   </Style>
   <Style x:Key="UsageProviderPicker" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"/>
   <Style x:Key="UsageProviderOption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="BorderThickness" Value="1"/>
   </Style>
  <Style x:Key="ProviderUsageProgress" TargetType="ProgressBar">
   <Setter Property="Height" Value="4"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
   <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
    <Grid SnapsToDevicePixels="True">
     <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"/>
     <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WindowCaptionButton" TargetType="Button">
   <Setter Property="views:Motion.Feedback" Value="False"/>
   <Setter Property="Width" Value="46"/><Setter Property="Height" Value="48"/>
   <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
   <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Arrow"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="{TemplateBinding Background}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     <Border x:Name="Focus" Margin="3" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowCaptionButton}">
   <Style.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CaptionCloseHover}"/><Setter Property="Foreground" Value="{DynamicResource CaptionCloseHoverText}"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource CaptionCloseHover}"/><Setter Property="Foreground" Value="{DynamicResource CaptionCloseHoverText}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
   <Style.Resources>
    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
     <Setter Property="HeaderTemplate"><Setter.Value><DataTemplate>
      <AccessText Text="{Binding}">
       <AccessText.Resources><Style TargetType="TextBlock"/></AccessText.Resources>
      </AccessText>
     </DataTemplate></Setter.Value></Setter>
    </Style>
   </Style.Resources>
  </Style>
  <Style x:Key="NotchButton" TargetType="Button">
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="views:Motion.Feedback" Value="True"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Grid Background="{TemplateBinding Background}">
      <Border Background="#18FFFFFF" CornerRadius="12" Opacity="{Binding Path=(views:Motion.Hover), RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"/>
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
      <Border x:Name="Focus" CornerRadius="12" BorderThickness="1" BorderBrush="Transparent" IsHitTestVisible="False"/>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="#808080"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
   <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/>
  </Style>
  <Style x:Key="NotchProviderButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid Background="{TemplateBinding Background}">
     <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
      <ContentPresenter/>
      <Ellipse x:Name="Focus" Width="44" Height="44" VerticalAlignment="Top" Stroke="Transparent" StrokeThickness="1" IsHitTestVisible="False"/>
     </Grid>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Stroke" Value="#808080"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="NotchSettingsButton" TargetType="Button" BasedOn="{StaticResource NotchButton}">
   <!-- The orb owns its hover drawing. Its larger hit region must not paint a
        second rectangular surface outside the black rail. -->
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Ellipse Fill="{TemplateBinding Background}"/>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     <Ellipse x:Name="Focus" Stroke="Transparent" StrokeThickness="1" Margin="4" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Stroke" Value="#808080"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="UsageModeButton" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/><Setter Property="Padding" Value="10,0"/>
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Grid>
     <Border x:Name="Surface" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
      <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <Border x:Name="Focus" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" IsHitTestVisible="False"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ControlHover}"/></Trigger>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource PrimaryText}"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
