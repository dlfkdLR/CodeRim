(version 1)
(allow default)
(deny network*)
(deny file-read-data (subpath (param "PERSONAL")))
(deny file-write*)
(allow file-write* (subpath (param "RUN")) (literal "/dev/null"))
(deny process-exec)
(allow process-exec (literal (param "APP")))
(deny user-preference-read)
(deny user-preference-write)
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc") (global-name "com.apple.CryptoTokenKit"))
