    "dimensions": {
      "functionality": {
        "winner": "TIE",
        "reason": "Independent drivers linked to released and candidate SQLiteDatabase actors produced identical 966-operation traces per variant on both macOS slices. Seventy independently specified rows passed actual commit, overwrite, readback, retained snapshot and both-version reopen. A second connection exercised concurrent writes, rollback, busy-write retry, commit, DDL, prepare and step messages before/after independent schema reads, invalid keys and recovery.",
        "evidence": [
          "baseline/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Rust/bridge/src/sqlite_checkpoint.rs"
        ]
      },
      "facts": {
        "winner": "TIE",
        "reason": "The published 18 projection columns, optional values, SQLite integer/float conversion, source key spellings and localized prepare/bind/step errors were preserved. Integrity check and user_version=18 succeeded on both releases after all probes. No version or schema change.",
        "evidence": [
          "baseline/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "baseline/Config/Release.env",
          "candidate/Config/Release.env"
        ]
      },
      "security": {
        "winner": "TIE",
        "reason": "The actor owns the cursor and a single connection. Rust binds a SQLITE_TRANSIENT input using a parameter, caps the byte count to i32 and rejects NUL. An independently compiled native test freed the short-lived original key before consuming the held row. Under another connection’s write, the old row stayed readable until finish, then the WAL could truncate. All statements and both connections closed cleanly.",
        "evidence": [
          "candidate/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Rust/bridge/src/sqlite_checkpoint.rs",
          "candidate/Rust/bridge/include/coderim_sqlite_checkpoint.h"
        ]
      },
      "maintainability": {
        "winner": "TIE",
        "reason": "The new cursor centralizes prepare, bind and reset with explicit ownership and tests while adding a second copy of the query for native fallback. Swift keeps a common typed projection. No additional regression was observed when a failed bind or stale schema invalidated the retained statement and the next read reparsed it.",
        "evidence": [
          "candidate/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Rust/bridge/src/sqlite_checkpoint.rs",
          "candidate/Rust/bridge/include/coderim_sqlite_checkpoint.h",
          "candidate/Scripts/rust_migration/sqlite-checkpoint/check.py"
        ]
      },
      "scope": {
        "winner": "TIE",
        "reason": "Only the collector-owned checkpoint query, small C ABI, feature wiring and its tests change. The read-reuse cursor does not hold the writer transaction open; actual writer timeout, rollback and retry matched the previous implementation.",
        "evidence": [
          "baseline/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Rust/bridge/src/sqlite_checkpoint.rs",
          "candidate/Scripts/rust_migration/sqlite-checkpoint/check.py"
        ]
      },
      "performance": {
        "winner": "B",
        "reason": "Independent actor-to-actor lookup loops ran nine alternating pairs for 32 hits, 400 mixed keys, and 550 misses. The arm64 medians fell from 7187/6810/6574 ns to 1767/1487/1325 ns. Under Rosetta, medians fell from 10477/10256/9553 ns to 2861/2354/2187 ns with equal offset checksums.",
        "evidence": [
          "baseline/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Sources/CodeRim/Persistence/SQLiteDatabase.swift",
          "candidate/Rust/bridge/src/sqlite_checkpoint.rs",
          "candidate/Scripts/rust_migration/sqlite-checkpoint/check.py"
        ]
      }
    },
