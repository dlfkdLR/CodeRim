1 VERSIONINFO
FILEVERSION @NUMBERS@
PRODUCTVERSION @NUMBERS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CodeRim\0"
            VALUE "FileDescription", "CodeRim Windows companion CLI\0"
            VALUE "FileVersion", "@FILE_VERSION@\0"
            VALUE "InternalName", "CodeRimCLI\0"
            VALUE "OriginalFilename", "@FILENAME@\0"
            VALUE "ProductName", "CodeRim\0"
            VALUE "ProductVersion", "@VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
